{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oselvar-metrics",
  "account_id": "f0c7420e826a094131e98342069c929d",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "routes": [
    {
      "pattern": "metrics.oselvar.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oselvar-metrics",
      "database_id": "bcbbccd5-ef48-43f8-ab90-18c70f3ed435"
    }
  ],
  "observability": {
    "enabled": true
  }
}
