{
  "name": "@oselvar/webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:migrate": "wrangler d1 execute oselvar-db --local --file=./migrations/0001_initial.sql",
    "db:migrate:prod": "wrangler d1 execute oselvar-db --remote --file=./migrations/0001_initial.sql"
  },
  "dependencies": {
    "@oselvar/core": "workspace:*",
    "@oselvar/linear": "workspace:*",
    "arctic": "^3.7.0",
    "lucia": "^3.2.2",
    "@lucia-auth/adapter-sqlite": "^3.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250127.0",
    "@sveltejs/adapter-cloudflare": "^6.0.1",
    "@sveltejs/kit": "^2.50.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "25.1.0",
    "svelte": "^5.48.2",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.16.0"
  }
}
